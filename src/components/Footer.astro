---
import { business, fullAddress } from '@/data/business';
import { counties } from '@/data/towns';
import { residentialServices } from '@/data/residential-services';
---
<footer class="site-footer dark">
  <div class="wrap cols">
    <div>
      <div class="f-brand"><span class="brand-x">X</span> <strong>BugBoss</strong> The X-Terminator</div>
      <p class="tagline">{business.tagline}</p>
      <p class="nap">
        {/* NAP is byte-identical to the Google Business Profile — audit H2 */}
        {fullAddress}<br />
        <a href={`tel:${business.phoneTollFreeE164}`}>{business.phoneVanity}</a> ({business.phoneTollFree})<br />
        <a href={`mailto:${business.email}`}>{business.email}</a><br />
        {business.hours}
      </p>
      <div class="social">
        <a href={business.social.facebook} rel="noopener">Facebook</a>
        <a href={business.social.tiktok} rel="noopener">TikTok</a>
        <a href={business.social.instagram} rel="noopener">Instagram</a>
        <a href={business.social.youtube} rel="noopener">YouTube</a>
      </div>
    </div>
    <div>
      <h4>Services</h4>
      <a href="/residential-pest-control/">Residential Pest Control</a>
      {residentialServices.map((rs) => (
        <a href={`/residential-pest-control/${rs.slug}/`}>· {rs.short}</a>
      ))}
      <a href="/commercial-pest-control/">Commercial — by Industry</a>
      <a href="/commercial-pest-control/manufacturing/">· Manufacturing & Industrial</a>
      <a href="/commercial-pest-control/food-processing/">· Food Processing</a>
      <a href="/commercial-pest-control/warehousing-distribution/">· Warehousing & Distribution</a>
      <a href="/commercial-pest-control/restaurants-food-service/">· Restaurants & Food Service</a>
      <a href="/wildlife-removal/">Wildlife Removal & Exclusion</a>
      <a href="/pest-library/">Pest Library</a>
      <a href="/pest-problems/">Common Problems</a>
      <a href="/guides/">Guides</a>
      <a href="/blog/">Blog</a>
    </div>
    <div>
      <h4>Company</h4>
      <a href="/about/">Our Story</a>
      <a href="/gallery/">Gallery</a>
      <a href="/reviews/">Reviews</a>
      <a href="/our-guarantee/">Our Guarantee</a>
      <a href="/no-contracts/">No Contracts</a>
      <a href="/contact/">Contact</a>
    </div>
    <div>
      <h4>Service Area</h4>
      <a href="/service-area/">All Towns We Serve</a>
      <a href="/pest-control/">Fox Valley & Green Bay Neighborhoods</a>
      <p class="counties">Serving {counties.slice(0, 6).join(', ')} and rural Northeast &amp; Central Wisconsin.</p>
    </div>
  </div>
  <div class="wrap legal">
    <span>© {business.foundingYear}–2026 {business.legalName}. Family-owned in {business.address.city}, WI. Licensed &amp; insured.</span>
    <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
  </div>
</footer>

<style>
  .site-footer { padding: 3rem 0 6.5rem; }
  .cols { display: grid; gap: 2rem; grid-template-columns: 1fr; }
  .cols h4 { color: #fff; font-size: .8rem; text-transform: uppercase; letter-spacing: .12em; margin-bottom: .8rem; }
  .cols a { display: block; color: #bfe0cb; text-decoration: none; padding: .2rem 0; font-size: .96rem; }
  .cols a:hover { color: #fff; }
  .f-brand { font-size: 1.3rem; margin-bottom: .4rem; }
  .f-brand .brand-x { display: inline-grid; place-items: center; width: 30px; height: 30px; background: var(--action); color: #fff; border-radius: 7px; font-weight: 900; vertical-align: middle; }
  .tagline { color: #9fc9ae; margin: .2rem 0 1rem; }
  .nap { font-size: .95rem; color: #cfe6d6; }
  .nap a { display: inline; color: #fff; }
  .social { display: flex; gap: .9rem; flex-wrap: wrap; margin-top: .6rem; }
  .social a { display: inline; font-weight: 600; }
  .counties { color: #9fc9ae; font-size: .9rem; }
  .legal { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: space-between; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,.12); font-size: .85rem; color: #9fc9ae; }
  .legal a { color: #cfe6d6; }
  @media (min-width: 720px) { .cols { grid-template-columns: 1.5fr 1fr 1fr 1fr; } }
</style>
