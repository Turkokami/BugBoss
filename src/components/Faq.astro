---
import type { FaqItem } from '@/lib/schema';
interface Props { items: FaqItem[]; heading?: string; }
const { items, heading = 'Frequently Asked Questions' } = Astro.props;
---
<div class="faq">
  <h2>{heading}</h2>
  {items.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
