---
import imageManifest from '../../public/images/manifest.json';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PhoneBar from '@/components/PhoneBar.astro';
import { business } from '@/data/business';
import { metaDescription } from '@/lib/meta';
import { buildGraph } from '@/lib/schema';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  /** This page's LCP image, preloaded in <head>. Must match the <Photo priority>. */
  lcpImage?: { src: string; sizes: string };
  /** Override the default social share card. Absolute path under /images/. */
  ogImage?: string;
  title: string;
  /** On-page framing. Also the fallback for the meta description, trimmed. */
  description: string;
  /** Hand-written search-result description, <=158 chars. Worth setting on any
   *  page earning real impressions; otherwise `description` is trimmed. */
  metaDescription?: string;
  /** Extra JSON-LD nodes (WebPage / FAQPage / BreadcrumbList / Service). */
  pageNodes?: object[];
  /** Path only, e.g. "/about/". Canonical is derived from business.url. */
  path?: string;
  noindex?: boolean;
}

const {
  title, description, pageNodes = [], path = '/', noindex = false,
  lcpImage, ogImage, metaDescription: metaOverride,
} = Astro.props;
// The Quick Answer is written to be read on the page and runs well past what a
// search result shows. Trim it to whole sentences for the meta tags; see
// src/lib/meta.ts for why, and prefer an explicit metaDescription where it matters.
const meta = metaOverride ?? metaDescription(description);

// Preload the LCP image. Without this the browser cannot discover it until it
// has parsed the HTML down to the <img>, which on a slow connection is well
// after the stylesheet has been fetched and applied -- so the largest paint
// waits on work that has nothing to do with it. The srcset/sizes here must
// match the <Photo> that renders it, or the browser downloads two files.
let lcpSrcset: string | undefined;
if (lcpImage) {
  const key = lcpImage.src.replace('/images/', '');
  const e = (imageManifest as Record<string, { width: number; widths: number[] }>)[key];
  if (e) {
    const base = key.replace(/\.webp$/, '');
    lcpSrcset = e.widths
      .map((w) => (w === e.width ? `${lcpImage.src} ${w}w` : `/images/${base}-${w}.webp ${w}w`))
      .join(', ');
  }
}
const canonical = new URL(path, business.url).href;
// Social scrapers need an absolute URL, and several of them (plus some
// messaging clients) still will not fetch a WebP, so the default card is a
// 1200x630 JPEG built from the brand banner. Pages can override it.
const shareImage = new URL(ogImage ?? '/images/og-default.jpg', business.url).href;
const graph = buildGraph(pageNodes);
// Title budget. A search result shows roughly 60 characters of a title before
// clipping it, and the " | BugBoss" suffix costs 10 of them on every page.
// Google appends the site name to a result itself, so paying for the brand a
// second time is only worth it when it is free -- append the suffix when the
// whole thing still fits, and drop it when it would push the title past the
// budget and clip the part that describes the page.
const TITLE_MAX = 60;
const suffixed = `${title} | ${business.shortName}`;
const fullTitle = title.includes('BugBoss')
  ? title
  : suffixed.length <= TITLE_MAX
    ? suffixed
    : title;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={meta} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={meta} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.name} — ${business.tagline}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={meta} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="geo.region" content="US-WI" />
    <meta name="geo.placename" content="Clintonville, Wisconsin" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {lcpSrcset && (
      <link rel="preload" as="image" href={lcpImage!.src}
        imagesrcset={lcpSrcset} imagesizes={lcpImage!.sizes} fetchpriority="high" />
    )}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <PhoneBar />
    <Analytics />
    <SpeedInsights />
    <style is:global>
      .skip { position: absolute; left: -999px; }
      .skip:focus { left: 12px; top: 12px; background: #fff; padding: .6rem 1rem; border-radius: 8px; z-index: 100; }
    </style>
  </body>
</html>
