---
import imageManifest from '../../public/images/manifest.json';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PhoneBar from '@/components/PhoneBar.astro';
import { business } from '@/data/business';
import { buildGraph } from '@/lib/schema';

interface Props {
  /** This page's LCP image, preloaded in <head>. Must match the <Photo priority>. */
  lcpImage?: { src: string; sizes: string };
  title: string;
  description: string;
  /** Extra JSON-LD nodes (WebPage / FAQPage / BreadcrumbList / Service). */
  pageNodes?: object[];
  /** Path only, e.g. "/about/". Canonical is derived from business.url. */
  path?: string;
  noindex?: boolean;
}

const { title, description, pageNodes = [], path = '/', noindex = false, lcpImage } = Astro.props;

// Preload the LCP image. Without this the browser cannot discover it until it
// has parsed the HTML down to the <img>, which on a slow connection is well
// after the stylesheet has been fetched and applied -- so the largest paint
// waits on work that has nothing to do with it. The srcset/sizes here must
// match the <Photo> that renders it, or the browser downloads two files.
let lcpSrcset: string | undefined;
if (lcpImage) {
  const key = lcpImage.src.replace('/images/', '');
  const e = (imageManifest as Record<string, { width: number; widths: number[] }>)[key];
  if (e) {
    const base = key.replace(/\.webp$/, '');
    lcpSrcset = e.widths
      .map((w) => (w === e.width ? `${lcpImage.src} ${w}w` : `/images/${base}-${w}.webp ${w}w`))
      .join(', ');
  }
}
const canonical = new URL(path, business.url).href;
const graph = buildGraph(pageNodes);
const fullTitle = title.includes('BugBoss') ? title : `${title} | ${business.shortName}`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="geo.region" content="US-WI" />
    <meta name="geo.placename" content="Clintonville, Wisconsin" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {lcpSrcset && (
      <link rel="preload" as="image" href={lcpImage!.src}
        imagesrcset={lcpSrcset} imagesizes={lcpImage!.sizes} fetchpriority="high" />
    )}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <PhoneBar />
    <style is:global>
      .skip { position: absolute; left: -999px; }
      .skip:focus { left: 12px; top: 12px; background: #fff; padding: .6rem 1rem; border-radius: 8px; z-index: 100; }
    </style>
  </body>
</html>
