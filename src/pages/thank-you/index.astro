---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { business } from '@/data/business';
import { webPageNode } from '@/lib/schema';
const url = business.url + '/thank-you/';
---
<BaseLayout title="Thanks — we got your message" description="Your request reached BugBoss The X-Terminator. We'll be in touch shortly." path="/thank-you/" noindex={true} pageNodes={[webPageNode({ url, name: 'Thank You', description: 'Message received.' })]}>
  <section>
    <div class="wrap narrow center">
      <p class="eyebrow center">Message received</p>
      <h1>Thanks — the BugBoss got it.</h1>
      <p class="lead">Your request came through. Brian and the BugBoss team will get back to you shortly. If it’s urgent, give us a call and we’ll get moving right away.</p>
      <div class="cta-row" style="justify-content:center">
        <a href={`tel:${business.phoneTollFreeE164}`} class="btn btn-action">Call {business.phoneVanity}</a>
        <a href="/" class="btn btn-ghost">Back to Home</a>
        <a href="/pest-library/" class="btn btn-ghost">Browse the Pest Library</a>
      </div>
    </div>
  </section>
</BaseLayout>
