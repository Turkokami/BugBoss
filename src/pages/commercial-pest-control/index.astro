---
import Photo from '@/components/Photo.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import { business } from '@/data/business';
import { getService } from '@/data/services';
import { webPageNode, faqPageNode, breadcrumbNode } from '@/lib/schema';

const s = getService('commercial-pest-control')!;
const url = `${business.url}/commercial-pest-control/`;

const items = (await getCollection('commercial')).sort((a, b) => a.data.order - b.data.order);
const groupsOrder = ['Food & Beverage', 'Manufacturing & Industrial', 'Retail & Hospitality', 'Institutional & Healthcare', 'Agricultural', 'Specialty'];
const byCat: Record<string, typeof items> = {};
for (const c of items) (byCat[c.data.category] ??= []).push(c);
const cats = groupsOrder.filter((g) => byCat[g]);

const faqs = [
  { q: 'What industries does BugBoss provide commercial pest control for?', a: 'BugBoss serves restaurants and food service, food processing, manufacturing, warehousing and distribution, grocery, retail, hotels and lodging, schools, healthcare and senior living, multi-family housing, offices, agricultural operations, grain and feed facilities, dairy and cheese processing, veterinary clinics, and museums across Central and Northeast Wisconsin.' },
  { q: 'What documentation do I get?', a: `A work order after every service, recording what was inspected, what was found, what was done and when — the record most inspections and health-department visits actually ask for. If your facility answers to a third-party audit scheme such as SQF, BRC or AIB, tell us what your auditor requires and we will build the program around it, including device maps, monitoring logs and corrective-action records where those are part of your scheme. We would rather agree that up front than have you discover a gap during an audit.` },
  { q: 'Does BugBoss follow Integrated Pest Management (IPM)?', a: 'Yes. Commercial programs are built on IPM — inspection, monitoring, sanitation and exclusion first, with targeted treatment as needed — which is both more effective and required or preferred in schools, healthcare, and food facilities.' },
  { q: 'Do you require a long-term contract for commercial service?', a: 'No. BugBoss builds a program that fits your facility and compliance needs without rigid long-term lock-in, and you work directly with the owner, Brian Zahringer, a certified Wisconsin Commercial Pesticide Applicator — not a rotating cast of route techs.' },
  { q: 'Can you schedule service around our operating hours?', a: 'Yes. BugBoss schedules discreet visits around production runs, service hours, and shifts so pest management does not disrupt your operation, staff, or customers.' },
];
const pageNodes = [
  webPageNode({ url, name: 'Commercial Pest Control by Industry', description: s.answer, primaryEntityId: `${business.url}/commercial-pest-control/#service` }),
  faqPageNode(url, faqs),
  breadcrumbNode(url, [{ name: 'Home', url: business.url + '/' }, { name: 'Commercial', url }]),
];
---
<BaseLayout title="Commercial Pest Control by Industry — Northeast & Central Wisconsin" description={s.answer} path="/commercial-pest-control/" pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow">Commercial</p>
      <h1>Commercial Pest Control, Built Industry by Industry</h1>
      <AnswerBox text={s.answer} />
      <figure class="band-photo">
        <Photo src="/images/brian-commercial.webp" sizes="(min-width: 460px) 420px, 100vw" alt="BugBoss treating the interior of a Northeast Wisconsin commercial building along the baseboards" />
      </figure>
      <p class="lead">{s.summary}</p>
      <p>A restaurant, a food plant, a dairy, a machine shop, a school, and a nursing home do not have the same pests, the same regulators, or the same tolerance for a problem — so they should not get the same pest program. BugBoss builds each program around the facility and the rules it answers to, with a work order for every visit, the record-keeping agreed against your scheme up front, and discreet scheduling that works around your operation. You deal directly with the owner, <a href="/about/">Brian Zahringer</a>, a certified Wisconsin Commercial Pesticide Applicator (Cert #{business.owner.licenseNumber}).</p>

      <h2>Compliance is the whole point out here</h2>
      <p>Food safety and facility audits do not care that you are in a small Wisconsin town. FDA FSMA and the Wisconsin Food Code, USDA and DATCP oversight, HACCP plans, third-party schemes like <strong>SQF, BRC, and AIB</strong>, GMPs, OSHA, DPI and health-department inspections, and Joint Commission and CMS standards in healthcare all apply the same whether you are in the Fox Valley or a village at the end of a county road. What rural facilities usually lack is a local pest partner who can service them fast <em>and</em> knows what those schemes actually ask of a pest program. That gap is exactly what BugBoss fills.</p>
      <h2>What you actually get in writing</h2>
      <p>Worth stating precisely, because this is where a lot of pest control marketing overpromises.</p>
      <p><strong>Every visit produces a work order</strong> — what was inspected, what was found, what was treated and when. That is the record a health inspector or a sanitarian normally asks to see, and keeping it current is the point of it.</p>
      <p>If your building answers to more than that — a third-party audit scheme, a franchise brand standard, a customer QA requirement — those schemes typically want a defined package on top: a written scope of service, device maps, a trend log read over time, corrective-action records, product labels and safety data sheets, and proof of licensing and insurance. <strong>Tell us what yours requires before the program starts</strong> and we will agree in writing who maintains which piece. Discovering that gap during an audit is the outcome worth avoiding, and one conversation at the outset avoids it.</p>
      <p>Licensing and insurance are straightforward: Wisconsin Commercial Applicator certification #{business.owner.licenseNumber}, general liability at {business.insurance.eachOccurrence} each occurrence and {business.insurance.generalAggregate} aggregate through {business.insurance.generalLiabilityCarrier}, workers' compensation through {business.insurance.workersCompCarrier}, and a certificate issued on request.</p>

      <h2>Why a rural facility gets a worse deal from a national route</h2>
      <p>It is rarely about the technician and almost always about the route economics. A facility at the end of a county road is the least convenient stop on somebody's day, which shows up in three predictable ways: the visit gets shortened, it gets rescheduled when the route runs late, and the person doing it changes often enough that nobody ever learns your building.</p>
      <p>That last one matters more than people expect. On a commercial account, knowing where the floor drains are, which dock seal failed last spring, and which line runs late is worth more than any product decision. It is the difference between an inspection and a walk-through.</p>

      <h2>What we will tell you not to buy</h2>
      <p>A great deal of commercial pest control is sold as a monthly visit that mostly consists of somebody walking the perimeter with a sprayer. If your building's actual problem is a dock seal, a drain that never gets scrubbed, a cardboard storage habit, or a dumpster sited against the wall, a recurring treatment manages the symptom indefinitely and never ends it.</p>
      <p>We would rather identify that and say so, even when the honest recommendation is a repair and a change of practice rather than a service agreement. There is <a href="/no-contracts/">no contract</a> on the table, which makes that a much easier conversation to have.</p>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <p class="eyebrow">Find your industry</p>
      <h2 class="mt0">Industry programs</h2>
      {cats.map((cat) => (
        <>
          <h3>{cat}</h3>
          <div class="grid cols-3">
            {byCat[cat].map((c) => (
              <a class="card" href={`/commercial-pest-control/${c.slug}/`}>
                <h3 style="font-size:1.05rem;margin:0 0 .3rem">{c.data.industry}</h3>
                <p style="font-size:.9rem;color:var(--muted);margin:0">{c.data.answer.slice(0, 110)}…</p>
              </a>
            ))}
          </div>
        </>
      ))}
      {items.length === 0 && <p>Industry pages are being published.</p>}
      <div class="coi">
        <p class="mt0"><strong>Need a certificate of insurance before we start?</strong>
          Say so when you call and we will have one issued. BugBoss carries general liability through
          {business.insurance.generalLiabilityCarrier} at {business.insurance.eachOccurrence} per occurrence and
          {business.insurance.generalAggregate} aggregate, plus workers' compensation through
          {business.insurance.workersCompCarrier} — and Brian is a licensed Wisconsin
          {business.owner.applicatorType} Applicator, Cert #{business.owner.licenseNumber}.
          Food processing, healthcare, schools and property management clients ask for this routinely;
          it is never a problem.</p>
      </div>
    </div>
  </section>

  <section><div class="wrap narrow"><Faq items={faqs} /></div></section>
  <Cta title="Need a commercial program that passes audit?" sub="Documented, discreet, and built around your industry's rules. Talk directly to the owner." />
  <style>
    .coi { background: var(--green-050); border-radius: var(--radius-lg); padding: 1.2rem 1.4rem; margin: 2rem 0 0; font-size: .96rem; }
    .band-photo { margin: 1.4rem auto; max-width: 420px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
    .band-photo :global(img) { width: 100%; height: auto; display: block; }
  </style>
</BaseLayout>
