---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import { business } from '@/data/business';
import { webPageNode, faqPageNode, breadcrumbNode } from '@/lib/schema';

export async function getStaticPaths() {
  const items = await getCollection('commercial');
  return items.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const { Content } = await render(c);
const url = `${business.url}/commercial-pest-control/${c.slug}/`;
// Sibling industries for cross-linking
const all = (await getCollection('commercial')).sort((a, b) => a.data.order - b.data.order);
const siblings = all.filter((x) => x.slug !== c.slug && x.data.category === c.data.category).slice(0, 4);
const pageNodes = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: c.data.title,
    serviceType: `Commercial pest control — ${c.data.industry}`,
    provider: { '@id': `${business.url}/#localbusiness` },
    areaServed: { '@type': 'AdministrativeArea', name: 'Central & Northeast Wisconsin' },
    url,
  },
  webPageNode({ url, name: c.data.title, description: c.data.answer, primaryEntityId: `${url}#service` }),
  faqPageNode(url, c.data.faqs),
  breadcrumbNode(url, [
    { name: 'Home', url: business.url + '/' },
    { name: 'Commercial', url: business.url + '/commercial-pest-control/' },
    { name: c.data.industry, url },
  ]),
];
---
<BaseLayout title={c.data.title} description={c.data.answer} path={`/commercial-pest-control/${c.slug}/`} pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow"><a href="/commercial-pest-control/">Commercial</a> · {c.data.category}</p>
      <h1>{c.data.title}</h1>
      <AnswerBox text={c.data.answer} />
      <article class="prose"><Content /></article>

      {siblings.length > 0 && (
        <>
          <h2>Related {c.data.category.toLowerCase()} programs</h2>
          <div class="grid cols-2">
            {siblings.map((s) => <a class="card" href={`/commercial-pest-control/${s.slug}/`}><h3 style="margin:0;font-size:1.02rem">{s.data.industry} →</h3></a>)}
          </div>
        </>
      )}
    </div>
  </section>
  {c.data.faqs.length > 0 && <section class="soft"><div class="wrap narrow"><Faq items={c.data.faqs} /></div></section>}
  <Cta title="Need a compliant commercial program?" sub="Documented, inspection-ready pest management built around your facility and your industry's rules. Talk to the owner." />
  <style>.eyebrow a{color:#0b1f00;text-decoration:none}</style>
</BaseLayout>
