---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import ExpertBlock from '@/components/ExpertBlock.astro';
import Faq from '@/components/Faq.astro';
import FactTable from '@/components/FactTable.astro';
import Cta from '@/components/Cta.astro';
import { business, cityState } from '@/data/business';
import { pests, getPest, type PestCategory } from '@/data/pests';
import { getPestId } from '@/data/pest-id';
import { getTown } from '@/data/towns';
import { expertNote } from '@/data/expert-notes';
import { webPageNode, faqPageNode, breadcrumbNode, articleNode } from '@/lib/schema';

export function getStaticPaths() {
  return pests.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const pest = getPest(slug!)!;
const url = `${business.url}/pest-library/${pest.slug}/`;

const deepEntries = await getCollection('pests', (e) => e.data.pest === pest.slug);
// Towns with a dedicated page for this pest — the other half of the crossing
// link, so the lattice is reachable from the pest side as well as the geo side.
const studies = (await getCollection('caseStudies', (e) => e.data.pest === pest.slug));
const crossings = (await getCollection('townpests', (e) => e.data.pest === pest.slug))
  .map((e) => ({ town: getTown(e.data.town)! }))
  .filter((c) => c.town)
  .sort((a, b) => a.town.name.localeCompare(b.town.name));
const deep = deepEntries[0];
let Body: any = null;
if (deep) Body = (await render(deep)).Content;

const answer = deep?.data.answer ?? pest.answer;
const faqs = deep?.data.faqs?.length ? deep.data.faqs : pest.faqs;

const catService: Record<PestCategory, { label: string; href: string }> = {
  insect: { label: 'Residential Pest Control', href: '/residential-pest-control/' },
  rodent: { label: 'Rodent Control & Exclusion', href: '/residential-pest-control/rodent-control/' },
  wildlife: { label: 'Wildlife Removal & Exclusion', href: '/wildlife-removal/' },
};
const svc = catService[pest.category];
const note = expertNote(pest.slug);
// Keystone v3.2 §4.3 — T6 declares its snippet shape as TABLE. Every pest
// profile carries the same five-row identification table plus the signs list,
// above the long-form body, so the extractable block sits in a predictable
// place and a reader who only wants "what is it, and have I got it" can stop
// after thirty seconds.
//
// About half the deep bodies also discuss signs in prose further down. That
// repetition is deliberate and conventional — this is an at-a-glance summary,
// which is why it is headed as one and uses an h3 rather than competing with
// the body's own h2.
const ident = getPestId(pest.slug);
const identRows = ident
  ? [
      { label: 'Size', value: ident.size },
      { label: 'How to tell it apart', value: ident.look },
      { label: 'Active in Wisconsin', value: pest.season },
      { label: 'Where you find it', value: ident.where },
      { label: 'What it actually does', value: ident.risk },
    ]
  : [];
const catLabel: Record<PestCategory, string> = {
  insect: 'Insects',
  rodent: 'Rodents',
  wildlife: 'Wildlife',
};
const pageNodes = [
  webPageNode({ url, name: `${pest.name} — Pest Library`, description: answer }),
  // §5.1: library pages carry an Article node authored + reviewed by the expert.
  articleNode({
    url,
    headline: `${pest.name} in Northeast Wisconsin`,
    description: answer,
    section: catLabel[pest.category],
    dateModified: business.contentReviewDate,
  }),
  faqPageNode(url, faqs),
  breadcrumbNode(url, [
    { name: 'Home', url: business.url + '/' },
    { name: 'Pest Library', url: business.url + '/pest-library/' },
    { name: pest.name, url },
  ]),
];
---
<BaseLayout title={`${pest.name} in Northeast Wisconsin`} description={answer} path={`/pest-library/${pest.slug}/`} pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow"><a href="/pest-library/">Pest Library</a> · {pest.season}</p>
      <h1>{pest.name} in Northeast Wisconsin</h1>
      <AnswerBox text={answer} />
      {note && <ExpertBlock note={note} />}

      <div class="at-a-glance">
        <h2 id="at-a-glance">{pest.name} at a glance</h2>
        <FactTable
          caption={`Size, appearance, season, location and risk for ${pest.name.toLowerCase()} in Northeast Wisconsin`}
          rows={identRows}
        />
        <h3>Signs you have {pest.name.toLowerCase()}</h3>
        <ul class="check">{pest.signs.map((s) => <li>{s}</li>)}</ul>
      </div>

      {Body ? (
        <article class="prose"><Body /></article>
      ) : (
        <p class="lead">{pest.overview}</p>
      )}

      {studies.length > 0 && (
        <div class="study-line">
          {studies.map((st) => (
            <p class="mt0">
              <strong>Real job:</strong> <a href={`/case-studies/${st.slug}/`}>{st.data.title}</a>
              — {st.data.outcome.toLowerCase()}.
            </p>
          ))}
        </div>
      )}

      {crossings.length > 0 && (
        <p class="towns-line">
          <strong>{pest.name} where you are:</strong>{' '}
          {crossings.map((c, i) => (
            <>
              {i > 0 && ' · '}
              <a href={`/service-area/${c.town.slug}/${pest.slug}/`}>{c.town.name}</a>
            </>
          ))}
        </p>
      )}

      <div class="callout">
        <p class="mt0"><strong>Have {pest.name.toLowerCase()}?</strong> BugBoss handles this across rural Northeast Wisconsin — locally, with no long-term contract.</p>
        <div class="cta-row">
          <a href={`tel:${business.phoneTollFreeE164}`} class="btn btn-action">Call {business.phoneVanity}</a>
          <a href={svc.href} class="btn btn-ghost">{svc.label} →</a>
        </div>
      </div>
    </div>
  </section>
  <section class="soft"><div class="wrap narrow"><Faq items={faqs} heading={`${pest.name}: Frequently Asked Questions`} /></div></section>
  <Cta
    title={`${pest.name} problem in ${cityState} or the surrounding rural corridor?`}
    sub={`Brian handles ${pest.name.toLowerCase()} across Waupaca, Shawano, Outagamie, Waushara and Oconto counties — licensed, insured, and no long-term contract.`}
  />
  <style>
    .callout { background: var(--green-050); border-radius: var(--radius-lg); padding: 1.4rem 1.5rem; margin: 2rem 0; }
    .eyebrow a { color: var(--green-600); text-decoration: none; }
    .study-line { margin-top: 1.6rem; padding: 1rem 1.2rem; background: var(--green-050); border-radius: var(--radius); font-size: .95rem; }
    .study-line p + p { margin-top: .5rem; }
    .at-a-glance { margin: 2rem 0 2.4rem; }
    .at-a-glance h3 { margin-top: 1.6rem; }
    .towns-line { margin-top: 1.6rem; padding: .9rem 1.1rem; background: var(--bg-soft); border-radius: var(--radius); font-size: .95rem; }
  </style>
</BaseLayout>
