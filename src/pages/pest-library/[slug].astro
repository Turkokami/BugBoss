---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import ExpertBlock from '@/components/ExpertBlock.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import { business, cityState } from '@/data/business';
import { pests, getPest, type PestCategory } from '@/data/pests';
import { expertNote } from '@/data/expert-notes';
import { webPageNode, faqPageNode, breadcrumbNode, articleNode } from '@/lib/schema';

export function getStaticPaths() {
  return pests.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const pest = getPest(slug!)!;
const url = `${business.url}/pest-library/${pest.slug}/`;

const deepEntries = await getCollection('pests', (e) => e.data.pest === pest.slug);
const deep = deepEntries[0];
let Body: any = null;
if (deep) Body = (await render(deep)).Content;

const answer = deep?.data.answer ?? pest.answer;
const faqs = deep?.data.faqs?.length ? deep.data.faqs : pest.faqs;

const catService: Record<PestCategory, { label: string; href: string }> = {
  insect: { label: 'Residential Pest Control', href: '/residential-pest-control/' },
  rodent: { label: 'Rodent Control & Exclusion', href: '/residential-pest-control/rodent-control/' },
  wildlife: { label: 'Wildlife Removal & Exclusion', href: '/wildlife-removal/' },
};
const svc = catService[pest.category];
const note = expertNote(pest.slug);
const catLabel: Record<PestCategory, string> = {
  insect: 'Insects',
  rodent: 'Rodents',
  wildlife: 'Wildlife',
};
const pageNodes = [
  webPageNode({ url, name: `${pest.name} — Pest Library`, description: answer }),
  // §5.1: library pages carry an Article node authored + reviewed by the expert.
  articleNode({
    url,
    headline: `${pest.name} in Northeast Wisconsin`,
    description: answer,
    section: catLabel[pest.category],
    dateModified: business.contentReviewDate,
  }),
  faqPageNode(url, faqs),
  breadcrumbNode(url, [
    { name: 'Home', url: business.url + '/' },
    { name: 'Pest Library', url: business.url + '/pest-library/' },
    { name: pest.name, url },
  ]),
];
---
<BaseLayout title={`${pest.name} in Northeast Wisconsin`} description={answer} path={`/pest-library/${pest.slug}/`} pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow"><a href="/pest-library/">Pest Library</a> · {pest.season}</p>
      <h1>{pest.name} in Northeast Wisconsin</h1>
      <AnswerBox text={answer} />
      {note && <ExpertBlock note={note} />}

      {Body ? (
        <article class="prose"><Body /></article>
      ) : (
        <>
          <p class="lead">{pest.overview}</p>
          <h2>Signs of {pest.name.toLowerCase()}</h2>
          <ul class="check">{pest.signs.map((s) => <li>{s}</li>)}</ul>
        </>
      )}

      <div class="callout">
        <p class="mt0"><strong>Have {pest.name.toLowerCase()}?</strong> BugBoss handles this across rural Northeast Wisconsin — locally, with no long-term contract.</p>
        <div class="cta-row">
          <a href={`tel:${business.phoneTollFreeE164}`} class="btn btn-action">Call {business.phoneVanity}</a>
          <a href={svc.href} class="btn btn-ghost">{svc.label} →</a>
        </div>
      </div>
    </div>
  </section>
  <section class="soft"><div class="wrap narrow"><Faq items={faqs} heading={`${pest.name}: Frequently Asked Questions`} /></div></section>
  <Cta
    title={`${pest.name} problem in ${cityState} or the surrounding rural corridor?`}
    sub={`Brian handles ${pest.name.toLowerCase()} across Waupaca, Shawano, Outagamie, Waushara and Oconto counties — licensed, insured, and no long-term contract.`}
  />
  <style>
    .callout { background: var(--green-050); border-radius: var(--radius-lg); padding: 1.4rem 1.5rem; margin: 2rem 0; }
    .eyebrow a { color: var(--green-600); text-decoration: none; }
  </style>
</BaseLayout>
