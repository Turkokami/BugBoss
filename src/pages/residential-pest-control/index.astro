---
import Photo from '@/components/Photo.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import Reviews from '@/components/Reviews.astro';
import { business } from '@/data/business';
import { getService } from '@/data/services';
import { residentialServices, residentialGroupsOrder } from '@/data/residential-services';
import { webPageNode, faqPageNode, breadcrumbNode } from '@/lib/schema';

const s = getService('residential-pest-control')!;
const url = `${business.url}/${s.slug}/`;

const byGroup: Record<string, typeof residentialServices> = {};
for (const rs of residentialServices) (byGroup[rs.group] ??= []).push(rs);
const groups = residentialGroupsOrder.filter((g) => byGroup[g]);

const faqs = [
  { q: 'How much does residential pest control cost in Wisconsin?', a: 'Cost depends on the pest, the size of the home, and whether exclusion work is needed. BugBoss gives a clear quote up front with no obligation and no long-term contract, so you know the price before any work begins.' },
  { q: 'Do you offer one-time treatments or only ongoing plans?', a: 'Both. Some problems are solved in a single visit; others — like fall invaders or seasonal rodents — are best handled with a recurring seasonal program. There is no contract requirement either way.' },
  { q: 'Are your treatments safe for kids and pets?', a: 'BugBoss uses targeted, professional products applied by a licensed applicator, and we advise on any re-entry timing for treated areas. We treat the specific pest rather than blanketing the home.' },
  { q: 'What is the most common home pest problem in this area?', a: 'Fall invaders — cluster flies, boxelder bugs, and Asian lady beetles — plus mice pushing indoors as it cools. Rural homes surrounded by fields and woods see these every year, which is why exclusion matters.' },
  { q: 'Do you seal entry points or just spray?', a: 'Both when it matters. For rodents and overwintering pests, sealing the entry points is the part that actually stops the problem from returning. Spraying alone treats what is inside; exclusion keeps the next wave out.' },
  { q: 'How soon can you come out?', a: `BugBoss is local to Clintonville, so response across the surrounding rural corridor is fast — often same-day for the closest towns. Call ${business.phoneVanity} to check current availability.` },
];
const pageNodes = [
  webPageNode({ url, name: s.name, description: s.answer, primaryEntityId: `${business.url}/${s.slug}/#service` }),
  faqPageNode(url, faqs),
  breadcrumbNode(url, [{ name: 'Home', url: business.url + '/' }, { name: s.name, url }]),
];
---
<BaseLayout title={`${s.name} in Northeast Wisconsin`} description={s.answer} path={`/${s.slug}/`} pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow">Residential Service</p>
      <h1>Residential Pest Control in Northeast Wisconsin</h1>
      <AnswerBox text={s.answer} />
      <figure class="band-photo">
        <Photo src="/images/field-shoe-covers.webp" sizes="(min-width: 360px) 320px, 100vw" alt="BugBoss technician wearing shoe covers while treating inside a customer's home in Northeast Wisconsin" />
      </figure>
      <p class="lead">{s.summary}</p>
      <style>
        .band-photo { margin: 1.4rem auto; max-width: 320px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
        .band-photo :global(img) { width: 100%; height: auto; display: block; }
      </style>

      <h2>What’s included</h2>
      <ul class="check">{s.bullets.map((b) => <li>{b}</li>)}</ul>

      <h2>The rural Wisconsin pest year, in order</h2>
      <p>Home pest control out here is far more predictable than most people expect. The same things happen in the same weeks every year, and knowing the order is most of what separates a house that has a problem every winter from one that does not.</p>
      <ul class="check">
        <li><strong>March, as the snow comes off.</strong> Two weeks when the ground is bare and nothing has grown back, so every vole runway, frost-opened foundation joint and ice-damaged soffit is visible from the driveway. The most useful hour of the year, and almost nobody spends it. <a href="/blog/spring-thaw-pest-check/">The walk-around</a>.</li>
        <li><strong>April–May.</strong> <a href="/pest-library/carpenter-ants/">Carpenter ants</a> wherever wood has been wet, first ant foraging, and — importantly — wasp queens starting nests that are still the size of a walnut and trivially removed.</li>
        <li><strong>May–June.</strong> <a href="/pest-library/ticks/">Ticks</a> at their most dangerous, because the nymphs are out and they are the size of a poppy seed. <a href="/pest-library/mosquitoes/">Mosquitoes</a> beginning, mostly from standing water on your own property.</li>
        <li><strong>July–September.</strong> <a href="/residential-pest-control/stinging-insects/">Stinging insects</a> at colony peak. A nest that was a walnut in May is a dinner plate by August, which is why every call arrives at once.</li>
        <li><strong>Late August–September.</strong> <strong>The single most important window of the year.</strong> An exterior treatment now, before the <a href="/residential-pest-control/fall-invaders/">fall invaders</a> mass on the siding, plus sealing. The identical treatment in late October does very little.</li>
        <li><strong>October–December.</strong> <a href="/residential-pest-control/rodent-control/">Rodents</a> off the harvested fields. A mouse needs about a quarter inch.</li>
        <li><strong>January–February.</strong> Nothing to treat. What you see at the sunny window has been in the wall since September and cannot breed indoors. <a href="/blog/bugs-indoors-in-january/">Why</a>.</li>
      </ul>

      <h2>Why exclusion is the half that lasts</h2>
      <p>Most durable pest control on a rural Wisconsin house is carpentry rather than chemistry, and it is worth understanding why before you buy anything.</p>
      <p>The gap at the soffit that lets cluster flies in during September is the same gap that gives wasps a void in July, squirrels a route in October, and mice a door in November. Treat the insects and you have solved this month. <strong>Close the gap and you have solved all four, for years.</strong></p>
      <p>That is why a BugBoss visit spends real time on the outside of the building — the foundation line, the sill plate, the utility penetrations, the window wells, the soffit and fascia, and whatever last winter's ice dams pulled apart. It is also why we would rather do a job that ends than sell a program that manages.</p>

      <h2>What we will tell you not to buy</h2>
      <p>A meaningful share of what people call about does not need treating at all, and you will hear that from us:</p>
      <ul class="check">
        <li><strong><a href="/pest-library/springtails/">Springtails</a>, <a href="/pest-library/millipedes/">millipedes</a> and <a href="/pest-library/sowbugs-pillbugs/">sowbugs</a> in a damp basement</strong> — a humidity problem. Dehumidifier, downspouts, grading.</li>
        <li><strong>Insects at the window in midwinter</strong> — already in the wall, cannot multiply, gone by spring. Vacuum them.</li>
        <li><strong>Wood cockroaches and most outdoor invaders</strong> — cannot establish indoors and die off.</li>
        <li><strong>A wasp nest high in a tree in late September</strong> — dead at hard frost.</li>
        <li><strong>A honey bee swarm</strong> — needs a beekeeper, not us.</li>
      </ul>
      <p>There is <a href="/no-contracts/">nothing to sign</a>, which makes that conversation considerably easier to have.</p>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <p class="eyebrow">Find your service</p>
      <h2 class="mt0">Home pest services</h2>
      <p class="lead" style="max-width:60ch">Every home problem has a focused service behind it — from a recurring general plan to rodent exclusion, bed bugs, stinging insects, and the fall invaders that rural Wisconsin homes fight every year. Pick the one that fits, or call and we’ll point you to it.</p>
      {groups.map((g) => (
        <>
          <h3>{g}</h3>
          <div class="grid cols-3">
            {byGroup[g].map((rs) => (
              <a class="card" href={`/residential-pest-control/${rs.slug}/`}>
                <h3 style="font-size:1.05rem;margin:0 0 .3rem">{rs.name}</h3>
                <p style="font-size:.9rem;color:var(--muted);margin:0">{rs.answer.slice(0, 120)}…</p>
              </a>
            ))}
          </div>
        </>
      ))}
      <p style="margin-top:1.4rem"><a href="/pest-library/" class="btn btn-ghost">Prefer to browse by pest? See the full Pest Library →</a></p>
    </div>
  </section>

  <Reviews limit={3} />
  <section><div class="wrap narrow"><Faq items={faqs} /></div></section>
  <Cta title="Home pest problem? Let’s solve it." />
</BaseLayout>
