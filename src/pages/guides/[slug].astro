---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import { business } from '@/data/business';
import { webPageNode, faqPageNode, breadcrumbNode } from '@/lib/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const url = `${business.url}/guides/${g.slug}/`;
const pageNodes = [
  webPageNode({ url, name: g.data.title, description: g.data.answer }),
  faqPageNode(url, g.data.faqs),
  breadcrumbNode(url, [
    { name: 'Home', url: business.url + '/' },
    { name: 'Guides', url: business.url + '/guides/' },
    { name: g.data.title, url },
  ]),
];
---
<BaseLayout title={g.data.title} description={g.data.answer} path={`/guides/${g.slug}/`} pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow"><a href="/guides/">Guides</a> · {g.data.category}</p>
      <h1>{g.data.title}</h1>
      <AnswerBox text={g.data.answer} />
      <article class="prose"><Content /></article>
    </div>
  </section>
  {g.data.faqs.length > 0 && <section class="soft"><div class="wrap narrow"><Faq items={g.data.faqs} /></div></section>}
  <Cta />
  <style>.eyebrow a{color:var(--green-600);text-decoration:none}</style>
</BaseLayout>
