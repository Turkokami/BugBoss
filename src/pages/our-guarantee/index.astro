---
// THE GUARANTEE — Rule 8: the warranty is defined once, here, with the covered
// period and exclusions stated explicitly, and every "guaranteed" elsewhere on
// the site links to this page. Terms confirmed by Brian, August 2026.
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Cta from '@/components/Cta.astro';
import Faq from '@/components/Faq.astro';
import { business } from '@/data/business';
import { webPageNode, faqPageNode, breadcrumbNode } from '@/lib/schema';

const url = business.url + '/our-guarantee/';
const answer =
  'The BugBoss guarantee applies to quarterly general pest service. If a covered household insect comes back between scheduled visits, we return and re-treat at no extra charge. It covers general household insects on the structures we treat — not fleas, cockroaches, bed bugs, carpenter ants, or other specializt work, which are quoted as their own jobs.';
const desc =
  'The BugBoss guarantee, stated plainly: what quarterly service covers, what it does not, and why we do not advertise a "lifetime" warranty.';

const covered = [
  'Spiders',
  'Asian lady beetles',
  'Boxelder bugs',
  'Stink bugs',
  'Common house ants',
  'Other general household insects',
];
const notCovered = [
  { pest: 'Stinging insects away from treated structures', why: 'Nests elsewhere on the property are a separate call — a ground nest at the fence line is a different job from a wasp nest on the eave we treated.', href: '/pest-library/wasps-hornets/' },
  { pest: 'Fleas', why: 'Almost always tied to a pet or a wildlife host, so it needs its own treatment plan and follow-up.', href: '/pest-library/fleas/' },
  { pest: 'Cockroaches', why: 'A specializt job with its own protocol and repeat visits.', href: '/pest-library/cockroaches/' },
  { pest: 'Bed bugs', why: 'Requires preparation, multiple visits and its own quote.', href: '/pest-library/bed-bugs/' },
  { pest: 'Carpenter ants', why: 'A wood-destroying insect tied to a moisture problem, not a general household pest.', href: '/pest-library/carpenter-ants/' },
  { pest: 'Rodents and wildlife', why: 'Exclusion work is a construction job as much as a pest job and is always quoted separately.', href: '/wildlife-removal/' },
];

const faqs = [
  { q: 'What exactly does the BugBoss guarantee cover?', a: `It covers general household insects on quarterly service — spiders, Asian lady beetles, boxelder bugs, stink bugs, common house ants and similar. If one of those comes back between your scheduled visits, we return and re-treat at no additional charge. It also covers stinging insects on the structures we treated. It does not extend to stinging insects elsewhere on the property, or to specializt pests like fleas, cockroaches, bed bugs and carpenter ants.` },
  { q: 'Do I need to be on quarterly service?', a: 'Yes — the guarantee is attached to the quarterly program, because that is what makes it meaningful. Re-treating between visits only works if there are scheduled visits to be between. One-off treatments and specializt jobs are quoted on their own terms, and we will tell you plainly at the time what is and is not included.' },
  { q: 'Is this a lifetime warranty?', a: 'No, deliberately. "Lifetime" guarantees in this industry are usually either unenforceable or so hedged they mean nothing, and overpromising is exactly the complaint people have about the national companies. A defined guarantee you can actually hold us to is worth more than a big word in small print. If we say we will come back, we come back.' },
  { q: 'Why are fleas, roaches and bed bugs excluded?', a: 'Because they are not general household insects and they are not solved by a quarterly perimeter treatment. Each one needs its own protocol, its own preparation, and usually more than one visit — bed bugs especially. Folding them into a general guarantee would mean either pricing quarterly service far higher for everyone, or quietly not honoring it. We would rather quote those jobs honestly and separately.' },
  { q: 'Why are carpenter ants excluded when regular ants are covered?', a: 'Because they are a different kind of problem. Common house ants are foraging in from outside and respond to general treatment. Carpenter ants are excavating wood to nest, almost always in timber a moisture problem softened first, and dealing with them properly means finding the colony and fixing the water. That is a job with its own inspection and quote, not something a quarterly service can promise.' },
  { q: 'What about rodents and wildlife?', a: 'Always quoted separately. Rodent and wildlife work is exclusion — sealing entry points with hardware cloth, repairing damaged soffits and roofline, closing voids under structures. It is closer to construction than to pest treatment, the scope varies enormously between buildings, and there is no honest way to bundle it into a flat guarantee.' },
  { q: 'Does the guarantee mean a contract?', a: `No. Quarterly service carries the guarantee, but there is no long-term contract lock-in and no cancellation fee. You stay because it works. That is the whole point — see our no contracts page.` },
  { q: 'How do I make a claim?', a: `Call ${business.phoneVanity} and tell us what you are seeing. If it is a covered pest and you are on quarterly service, we schedule a return visit — there is no form to fill in and no argument about it. Brian is the person who did the original treatment and he is the person who comes back.` },
];

const pageNodes = [
  webPageNode({ url, name: 'Our Guarantee', description: answer }),
  faqPageNode(url, faqs),
  breadcrumbNode(url, [{ name: 'Home', url: business.url + '/' }, { name: 'Our Guarantee', url }]),
];
---
<BaseLayout title="Our Guarantee" description={desc} path="/our-guarantee/" pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow">Our promise</p>
      <h1>The BugBoss Guarantee</h1>
      <AnswerBox text={answer} />

      <h2>What is covered</h2>
      <p>The guarantee applies to <strong>quarterly general pest service</strong>. If one of these comes back between your scheduled visits, we return and re-treat at no additional charge:</p>
      <div class="tag-grid">{covered.map((c) => <span class="tag">{c}</span>)}</div>
      <p style="margin-top:1.2rem">It also covers <strong>stinging insects on the structures we treated</strong> — the eave, the soffit, the door frame we worked on.</p>

      <h2>What is not covered</h2>
      <p>Stated plainly, because a guarantee with hidden edges is not a guarantee. These are all work we do — they are just quoted as their own jobs rather than folded into quarterly service:</p>
      <ul class="not-covered">
        {notCovered.map((n) => (
          <li>
            <a href={n.href}><strong>{n.pest}</strong></a> — {n.why}
          </li>
        ))}
      </ul>

      <h2>Why we do not say “lifetime”</h2>
      <p>
        Overpromising is the single most common complaint people have about the national
        pest companies, and a “lifetime warranty” that nobody intends to honor is worse
        than no warranty at all. A defined guarantee, with its edges written down where you
        can read them before you buy, is worth more than a big word in small print.
      </p>
      <p>
        The other half of that: <a href="/no-contracts/">there is no long-term contract</a>.
        The guarantee comes with the quarterly program, not with a lock-in.
      </p>

      <div class="callout">
        <p class="mt0"><strong>Making a claim is a phone call.</strong> Ring
          <a href={`tel:${business.phoneTollFreeE164}`}>{business.phoneVanity}</a> and say what you are
          seeing. Brian did the original treatment and Brian is who comes back.</p>
      </div>
    </div>
  </section>
  <section class="soft"><div class="wrap narrow"><Faq items={faqs} /></div></section>
  <Cta />
  <style>
    .not-covered { list-style: none; padding: 0; margin: 1rem 0 0; }
    .not-covered li { padding: .7rem 0; border-bottom: 1px solid var(--line); font-size: .98rem; }
    .not-covered li:last-child { border-bottom: 0; }
    .not-covered a { color: var(--green-700); }
    .callout { background: var(--green-050); border-radius: var(--radius-lg); padding: 1.2rem 1.4rem; margin: 2rem 0 0; }
  </style>
</BaseLayout>
