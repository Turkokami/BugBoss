---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import { business } from '@/data/business';
import { townsWithPages, getTown, hasWildlifeSpoke } from '@/data/towns';
import { townServiceNode } from '@/lib/geo';
import { webPageNode, faqPageNode, breadcrumbNode } from '@/lib/schema';

export function getStaticPaths() {
  return townsWithPages.filter(hasWildlifeSpoke).map((t) => ({ params: { town: t.slug } }));
}

const { town } = Astro.params;
const t = getTown(town!)!;
const L = t.local!;
const url = `${business.url}/service-area/${t.slug}/wildlife/`;
const answer = `BugBoss removes and excludes wildlife in ${t.name}, WI — bats, raccoons, squirrels, skunks, and more. Working on ${L.housing}, we evict humanely, seal every entry, and clean up. Bat work follows Wisconsin DNR maternity-season timing. Local, licensed, and no contract.`;
const faqs = [
  { q: `Does BugBoss remove bats in ${t.name}?`, a: `Yes, and legally. Bats are protected in Wisconsin, so BugBoss uses humane exclusion within DNR maternity-season timing (restricted roughly June 1–Aug 15). Around ${t.name}, ${L.housing} often mean older structures where bats find their way in.` },
  { q: `What wildlife is common around ${t.name}?`, a: `Given ${t.name}’s ${L.housing} and surroundings like ${L.landmarks[0] ?? 'the local landscape'}, we handle bats, raccoons, squirrels, and skunks most often — plus the occasional groundhog, snake, or woodpecker.` },
  { q: `What’s the difference between removal and exclusion?`, a: `Removal takes the animal out; exclusion seals the building so nothing gets back in. In ${t.name}, lasting results require both, which is why BugBoss finds and closes every entry point, not just the obvious one.` },
  { q: `Do you clean up after wildlife in ${t.name}?`, a: `Yes. Droppings and contamination from bats and raccoons are health hazards, so cleanup and decontamination are part of a complete BugBoss wildlife job in ${t.name}.` },
];
const pageNodes = [
  webPageNode({ url, name: `Wildlife Removal in ${t.name}, WI`, description: answer, primaryEntityId: `${url}#service` }),
  townServiceNode(t, url),
  faqPageNode(url, faqs),
  breadcrumbNode(url, [
    { name: 'Home', url: business.url + '/' },
    { name: 'Service Area', url: business.url + '/service-area/' },
    { name: t.name, url: `${business.url}/service-area/${t.slug}/` },
    { name: 'Wildlife', url },
  ]),
];
---
<BaseLayout title={`Wildlife Removal & Exclusion in ${t.name}, WI`} description={answer} path={`/service-area/${t.slug}/wildlife/`} pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow"><a href={`/service-area/${t.slug}/`}>{t.name}</a> · Wildlife</p>
      <h1>Wildlife Removal &amp; Exclusion in {t.name}, WI</h1>
      <AnswerBox text={answer} />
      <p class="lead">{L.intro}</p>
      <p>Wildlife work in {t.name} is exclusion work, not a spray. On {L.housing}, animals get into attics, chimneys, soffits, barns, and crawlspaces — and the only lasting fix is to remove them and seal the structure. BugBoss does both, and handles the DNR-regulated bat work most companies out here won’t take on.</p>
      <h2>What BugBoss handles in {t.name}</h2>
      <ul class="check">
        <li>Bats — humane, DNR-compliant exclusion and guano cleanup</li>
        <li>Raccoons, squirrels, and skunks in attics, chimneys, and outbuildings</li>
        <li>Groundhogs, moles, voles, snakes, and woodpeckers</li>
        <li>Permanent exclusion — sealing every entry point</li>
        <li>Cleanup and decontamination</li>
      </ul>
      <div class="callout">
        <p class="mt0"><strong>Something in the attic or barn in {t.name}?</strong> Call Brian — don’t corner the animal.</p>
        <div class="cta-row"><a href={`tel:${business.phoneTollFreeE164}`} class="btn btn-action">Call {business.phoneVanity}</a><a href="/wildlife-removal/" class="btn btn-ghost">About wildlife service →</a></div>
      </div>
    </div>
  </section>
  <section class="soft"><div class="wrap narrow"><Faq items={faqs} heading={`Wildlife Removal in ${t.name}: FAQs`} /></div></section>
  <Cta />
  <style>.eyebrow a{color:var(--green-600);text-decoration:none}.callout{background:var(--green-050);border-radius:var(--radius-lg);padding:1.4rem 1.5rem;margin:2rem 0}</style>
</BaseLayout>
