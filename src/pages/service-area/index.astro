---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cta from '@/components/Cta.astro';
import Faq from '@/components/Faq.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import { business } from '@/data/business';
import { towns } from '@/data/towns';
import { webPageNode, faqPageNode, breadcrumbNode } from '@/lib/schema';

const url = business.url + '/service-area/';
const desc = `BugBoss serves a ${business.serviceRadiusMiles}-mile radius from Clintonville, WI — ${business.serviceCounties.length} Wisconsin counties including Waupaca, Shawano, Outagamie, Waushara, Oconto and Langlade, plus the Fox Valley and Green Bay edge.`;
const answer = `BugBoss works within about ${business.serviceRadiusMiles} miles of Clintonville, WI, which touches ${business.serviceCounties.length} Wisconsin counties. The deepest coverage is the rural corridor closest to home — Waupaca, Shawano and Outagamie — with full service out to the Fox Valley, Green Bay, Stevens Point and Wisconsin Rapids edges.`;
const tiers = [
  { n: 1 as const, label: 'Our Home Territory (0–20 miles)', note: 'Deepest coverage, fastest response — this is home.' },
  { n: 2 as const, label: 'The Surrounding Ring (20–35 miles)', note: 'Full service across the towns just beyond home base.' },
  { n: 3 as const, label: 'The Fox Valley & Green Bay Edge (35–55 miles)', note: 'Serving the metro edge for pest and wildlife needs.' },
  { n: 4 as const, label: 'Extended Rural Wisconsin (55–75 miles)', note: 'Reaching the underserved rural communities farther out.' },
];
const withPages = new Set(towns.filter((t) => t.cluster !== 'area').map((t) => t.slug));
const faqs = [
  { q: 'What counties does BugBoss serve?', a: `Any part of ${business.serviceCounties.length} Wisconsin counties falls inside our ${business.serviceRadiusMiles}-mile radius from Clintonville: ${business.serviceCounties.map((c) => c.replace(' County', '')).join(', ')}. The heaviest coverage is the rural corridor closest to home — Waupaca, Shawano and Outagamie — and the outer counties are reached at their nearer edges rather than end to end.` },
  { q: 'Is that 60 miles of driving?', a: `No, and the distinction matters. It is a 60-mile straight-line radius measured from downtown Clintonville, so actual travel distance to somewhere near the edge is longer than 60 miles of road. A county is included if any part of it falls inside that circle, which means the far corners of the outer counties are genuinely marginal. If you are out near the boundary, call ${business.phoneVanity} and we will tell you straight away rather than guessing.` },
  { q: 'Do you charge extra for rural or out-of-town service?', a: 'BugBoss is built for rural Wisconsin, so serving out-of-town properties is normal, not an exception. Any travel considerations for the farthest communities are discussed up front when you call — no surprises.' },
  { q: 'My town isn’t listed — can you still help?', a: `Very likely yes. The list is not exhaustive, and BugBoss covers a wide rural radius from Clintonville. Call ${business.phoneVanity} and we’ll tell you right away whether we serve your area.` },
  { q: 'How fast can you get to me?', a: `It depends honestly on where you are, and the tiers above are the best guide. Clintonville and the villages within about twenty miles — Embarrass, Marion, Bear Creek, Symco — are same-day or next-day for an ordinary job. The middle ring is usually within a few days. Out at the Fox Valley, Green Bay, Stevens Point or Wisconsin Rapids edge, work gets grouped into runs rather than dropped into any open slot, so it is worth calling with some notice. The 24-hour emergency line is answered wherever you are.` },
  { q: 'Why is your coverage deepest in the small towns rather than the cities?', a: 'Because that is where the gap is. The Fox Valley and Green Bay have plenty of pest companies; the villages and farm properties between them frequently have none that will do wildlife work, or none that will make the drive for a single job. We are built around that corridor rather than around volume, which is why the towns closest to Clintonville get dedicated pages and the metros get a smaller, more specific offer.' },
  { q: 'Do you go into the metros at all?', a: 'Yes, selectively. What justifies the drive into Green Bay or the Fox Valley is the work most metro pest routes decline — wildlife inside a structure, exclusion on older housing, and multi-unit bed bug or cockroach jobs that have to be scoped as one building. For a routine call in the middle of the city, a company based there will beat us on response time and we will say so.' },
  { q: 'Is there a travel surcharge?', a: 'No. The quote is the quote and you get it before anything starts, wherever you are in the radius. Distance affects scheduling rather than price — the farther out you are, the more the work gets grouped into a run rather than done on demand.' },
];
const pageNodes = [
  webPageNode({ url, name: 'Service Area', description: desc }),
  faqPageNode(url, faqs),
  breadcrumbNode(url, [{ name: 'Home', url: business.url + '/' }, { name: 'Service Area', url }]),
];
---
<BaseLayout title="Service Area — Rural Northeast & Central Wisconsin" description={desc} path="/service-area/" pageNodes={pageNodes}>
  <section>
    <div class="wrap">
      <p class="eyebrow">Where we work</p>
      <h1>BugBoss Service Area</h1>
      <AnswerBox text={answer} />
      <p class="lead">Based in Clintonville, BugBoss serves the rural and small-town corridor the national companies skip — and reaches the metro edge from there. Towns with a link have a dedicated local page; the rest are fully served, just call.</p>

      <div class="sa-intro">
        <h2>Why the coverage is shaped this way</h2>
        <p>Most pest companies in this part of Wisconsin are built around the population: they work Appleton, Neenah, Oshkosh and Green Bay, and the countryside in between gets a truck when a route happens to pass through it. That leaves a genuine gap, and the gap is the whole reason this business is shaped the way it is.</p>
        <p>So the depth runs the other way round. The villages and farm country closest to Clintonville get <strong>dedicated pages, the fastest response, and the full range of work</strong> — because out here we are frequently the only option, particularly for anything involving an animal in a building. The metros get a narrower and more specific offer: the jobs the volume companies decline, rather than a pretence that we can outrun somebody based twenty minutes closer to you.</p>
        <p>That is also why the tiers below are labeled by distance rather than by importance. They describe how quickly we can reasonably be there, which is the thing you actually need to know.</p>
      </div>

      <div class="radius-box">
        <p class="mt0"><strong>{business.serviceCounties.length} counties within about {business.serviceRadiusMiles} miles of Clintonville</strong></p>
        <div class="tag-grid">
          {business.serviceCounties.map((c) => <span class="tag">{c.replace(' County', '')}</span>)}
        </div>
        <p class="radius-note">
          Measured as a {business.serviceRadiusMiles}-mile straight-line radius from downtown
          Clintonville, so real driving distance to the outer edge is longer. A county is listed
          if any part of it falls inside that circle — the far corners of the outer counties are
          marginal, so if you are near the boundary, call and we will give you a straight answer.
        </p>
      </div>
      {tiers.map((tier) => {
        const list = towns.filter((t) => t.tier === tier.n);
        return (
          <>
            <h2>{tier.label}</h2>
            <p style="margin-top:-.4rem;color:var(--muted)">{tier.note}</p>
            <div class="tag-grid" style="margin-bottom:1rem">
              {list.map((t) => (
                withPages.has(t.slug)
                  ? <a href={`/service-area/${t.slug}/`} class="tag tag-link">{t.name}</a>
                  : <span class="tag">{t.name}</span>
              ))}
            </div>
          </>
        );
      })}
    </div>
  </section>
  <section class="soft"><div class="wrap narrow"><Faq items={faqs} /></div></section>
  <Cta />
  <style>
    a.tag-link { text-decoration: none; }
    a.tag-link:hover { background: var(--green-500); color: #fff; }
  </style>
  <style>.sa-intro { margin: 1.8rem 0; max-width: 68ch; }</style>
</BaseLayout>
