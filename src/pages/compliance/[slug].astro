---
// T8 — COMPLIANCE PAGE. Block order per Master Plan §4.2:
// the rule stated plainly → who it applies to → obligations → penalties →
// how we help → source citation and review date → FAQ → CTA.
//
// The source line and review date are rendered by the template rather than
// left to the body copy, so Rule 7 ("every factual or legal claim carries a
// source and a review date") cannot be forgotten on a page of legal claims.
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import { business } from '@/data/business';
import { webPageNode, faqPageNode, breadcrumbNode, articleNode } from '@/lib/schema';

export async function getStaticPaths() {
  const pages = await getCollection('compliance');
  return pages.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const { Content } = await render(c);
const url = `${business.url}/compliance/${c.slug}/`;
const pageNodes = [
  webPageNode({ url, name: c.data.title, description: c.data.answer }),
  articleNode({
    url,
    headline: c.data.title,
    description: c.data.answer,
    section: 'Compliance',
    dateModified: business.contentReviewDate,
  }),
  faqPageNode(url, c.data.faqs),
  breadcrumbNode(url, [
    { name: 'Home', url: business.url + '/' },
    { name: 'Compliance', url: business.url + '/compliance/' },
    { name: c.data.short, url },
  ]),
];
---
<BaseLayout title={c.data.title} description={c.data.answer} path={`/compliance/${c.slug}/`} pageNodes={pageNodes}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow"><a href="/compliance/">Compliance</a> · {c.data.audience}</p>
      <h1>{c.data.title}</h1>
      <AnswerBox text={c.data.answer} />

      <aside class="notice">
        <p class="mt0"><strong>This is general information, not legal advice.</strong>
        Rules change and local ordinances can be stricter than state ones. For a
        dispute, a citation, or anything with money or a tenancy riding on it,
        check the current text of the rule and talk to a lawyer or the agency
        that administers it.</p>
      </aside>

      <article class="prose"><Content /></article>

      <div class="source">
        <p class="mt0"><strong>Source:</strong>
          {c.data.sourceUrl
            ? <a href={c.data.sourceUrl} rel="noopener">{c.data.source}</a>
            : c.data.source}
        </p>
        <p class="mt0">
          Reviewed by {business.owner.name}, Wisconsin {business.owner.applicatorType}
          Pesticide Applicator #{business.owner.licenseNumber} — {c.data.reviewed}.
        </p>
      </div>
    </div>
  </section>
  {c.data.faqs.length > 0 && (
    <section class="soft"><div class="wrap narrow"><Faq items={c.data.faqs} /></div></section>
  )}
  <Cta
    title={`Need this handled properly in ${business.address.city} or the surrounding counties?`}
    sub="Licensed, insured, and documented — the paperwork side matters as much as the treatment."
  />
  <style>
    .eyebrow a { color: var(--green-600); text-decoration: none; }
    .notice {
      background: var(--bg-soft);
      border-left: 4px solid var(--gold, #d6a100);
      border-radius: var(--radius);
      padding: 1rem 1.2rem;
      margin: 1.6rem 0 2rem;
      font-size: .95rem;
    }
    .source {
      margin-top: 2.5rem;
      padding-top: 1.2rem;
      border-top: 1px solid var(--line);
      font-size: .88rem;
      color: var(--muted);
    }
    .source p { margin: .2rem 0; }
  </style>
</BaseLayout>
