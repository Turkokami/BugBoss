---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { business } from '@/data/business';
---
<BaseLayout title="Page Not Found" description="That page couldn’t be found." path="/404/" noindex={true}>
  <section><div class="wrap narrow center">
    <h1>We couldn’t find that page</h1>
    <p class="lead">The page may have moved. Try one of these, or just give us a call.</p>
    <div class="cta-row" style="justify-content:center">
      <a href="/" class="btn btn-green">Home</a>
      <a href="/pest-library/" class="btn btn-ghost">Pest Library</a>
      <a href="/service-area/" class="btn btn-ghost">Service Area</a>
      <a href={`tel:${business.phoneTollFreeE164}`} class="btn btn-action">Call {business.phoneVanity}</a>
    </div>
  </div></section>
</BaseLayout>
