---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { business } from '@/data/business';
import { webPageNode } from '@/lib/schema';
const url = business.url + '/privacy/';
---
<BaseLayout title="Privacy Policy" description="BugBoss The X-Terminator privacy policy." path="/privacy/" pageNodes={[webPageNode({ url, name: 'Privacy Policy', description: 'Privacy policy' })]} noindex={true}>
  <section><div class="wrap narrow">
    <h1>Privacy Policy</h1>
    <p>BugBoss The X-Terminator respects your privacy. This page describes how we handle information collected through this website.</p>
    <p><em>Placeholder — replace with your reviewed privacy policy before launch. Include how contact-form data is collected, stored, and used, any analytics or advertising cookies in use, and contact details for privacy requests.</em></p>
    <p>Questions? Contact us at <a href={`mailto:${business.email}`}>{business.email}</a>.</p>
  </div></section>
</BaseLayout>
